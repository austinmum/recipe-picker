# Copy this file to .env and fill in the key for the provider you chose in config.toml.
# .env is ignored by git, so your keys stay on this computer.

# provider = "openai"
OPENAI_API_KEY=

# provider = "azure_key"
AZURE_OPENAI_API_KEY=

# provider = "azure_entra" needs no key: run `az login` instead.
